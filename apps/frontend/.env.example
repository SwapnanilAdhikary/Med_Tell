VITE_API_URL=

# ===== Vapi (in-browser voice calls) =====
# Get a public key from the Vapi dashboard -> "Your Account" -> Public Key.
# The assistant is configured on the backend via VAPI_ASSISTANT_ID (apps/backend/.env).
VITE_VAPI_PUBLIC_KEY=

# ===== Mapbox (the worker's report map at /field/map) =====
# Account -> Access tokens -> default public token (starts with pk.).
# Leave blank and /field/map shows a "not configured" card instead of a blank box.
VITE_MAPBOX_TOKEN=
