# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== MongoDB =====
# Port 27018 matches docker-compose.yml. Use 27017 for a local mongod.
MONGO_URI=mongodb://127.0.0.1:27018/iem-hacks

# ===== Auth =====
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Must support image input - used for medical document analysis.
OPENAI_VISION_MODEL=gpt-4o-mini

# ===== Vapi (voice agent) =====
# Either create an assistant in the dashboard manually, or run
# `npm run vapi:setup --workspace @iem-hacks/backend` to create/update it
# automatically (VAPI_ASSISTANT_ID is then written back here).
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEB_SECRET=
# Public URL of the backend webhook, only needed for phone calls:
#   VAPI_WEBHOOK_URL=https://<your-ngrok-tunnel>/api/calls/vapi/webhook

# ===== Uploads =====
UPLOAD_DIR=uploads
