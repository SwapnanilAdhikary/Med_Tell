{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "cd ../.. && npm run build --workspace @iem-hacks/backend",
  "installCommand": "cd ../.. && npm install --include=dev",
  "outputDirectory": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
